# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://meetx:meetx_dev_password@localhost:5432/meetx?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-this-secret-before-deploy-32chars
DATA_ENCRYPTION_KEY=
AVATAR_STORAGE_DIR=uploads/avatars
SENTRY_DSN=

# Local platform bootstrap account
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Speech-to-text
STT_PROVIDER=deepgram
STT_API_KEY=
STT_MODEL=

# Translation
TRANSLATE_PROVIDER=anthropic
TRANSLATE_API_KEY=
TRANSLATE_MODEL=

# Text-to-speech
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE_MALE=
TTS_VOICE_FEMALE=

# Meeting bot
MEETING_BOT_PROVIDER=recall
MEETING_BOT_API_KEY=
MEETING_BOT_REGION=

# LiveKit local development defaults
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=meetx
S3_ACCESS_KEY=meetx_minio
S3_SECRET_KEY=meetx_minio_password
S3_REGION=us-east-1

# Embeddings and knowledge answers
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
ANSWER_MODEL=
ANSWER_REASONING_MODEL=
DEEP_MAX_STEPS=4
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# Email: console, SMTP, or provider API
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Interpreter AI <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
