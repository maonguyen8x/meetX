generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, vector]
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  USER

  @@map("platform_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum AccountType {
  INDIVIDUAL
  ENTERPRISE_MEMBER

  @@map("account_type")
}

enum Locale {
  vi
  en
  ja

  @@map("locale")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum OrganizationRole {
  ORG_ADMIN
  ORG_MEMBER

  @@map("organization_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum PermissionScope {
  PLATFORM
  ORG

  @@map("permission_scope")
}

enum PermissionEffect {
  ALLOW
  DENY

  @@map("permission_effect")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE

  @@map("auth_token_type")
}

enum VoiceGender {
  MALE
  FEMALE
  NEUTRAL

  @@map("voice_gender")
}

enum VoiceStyle {
  WARM
  PROFESSIONAL
  ENERGETIC

  @@map("voice_style")
}

enum TriggerMode {
  AUTO
  MANUAL
  SUMMARY

  @@map("trigger_mode")
}

enum StorageMode {
  LOCAL
  CLOUD

  @@map("storage_mode")
}

enum MeetingType {
  BOT
  ROOM

  @@map("meeting_type")
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  TEAMS
  INTERNAL

  @@map("meeting_platform")
}

enum MeetingStatus {
  CREATED
  JOINING
  LIVE
  ENDED
  FAILED
  DENIED

  @@map("meeting_status")
}

enum BillingOwnerType {
  USER
  ORGANIZATION

  @@map("billing_owner_type")
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR

  @@map("billing_interval")
}

enum BillingCycle {
  DAY
  WEEK
  MONTH
  YEAR
  CUSTOM

  @@map("billing_cycle")
}

enum PlanAudience {
  INDIVIDUAL
  ENTERPRISE
  ANY

  @@map("plan_audience")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

enum ExpiryAction {
  NOTIFY_ONLY
  SWITCH_TO_FREE
  PAUSE
  CANCEL

  @@map("expiry_action")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@map("invoice_status")
}

enum InvoiceItemKind {
  PLAN
  OVERAGE
  TOPUP
  ADJUSTMENT

  @@map("invoice_item_kind")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum WalletTransactionType {
  TOPUP
  USAGE
  PLAN_GRANT
  REFUND
  ADJUSTMENT

  @@map("wallet_transaction_type")
}

enum UsageKind {
  STT
  LLM_IN
  LLM_OUT
  TTS
  BOT
  VIDEO
  EMBED
  STORAGE
  WEB_SEARCH

  @@map("usage_kind")
}

enum UsageUnit {
  SEC
  TOKEN
  CHAR
  MIN
  BYTE
  QUERY

  @@map("usage_unit")
}

enum QuotaMetric {
  INTERPRET_MINUTES
  AI_TOKENS
  STORAGE_BYTES
  DOCUMENT_COUNT
  MEMBER_COUNT
  SEARCH_QUERIES

  @@map("quota_metric")
}

enum NotificationType {
  QUOTA_80
  QUOTA_90
  QUOTA_100
  RENEWAL_REMINDER
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRED
  DOC_READY
  DOC_FAILED
  MEMBER_INVITED
  SYSTEM

  @@map("notification_type")
}

enum DeliveryChannel {
  EMAIL
  IN_APP

  @@map("delivery_channel")
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED

  @@map("delivery_status")
}

enum FolderVisibility {
  PRIVATE
  ORGANIZATION
  SHARED

  @@map("folder_visibility")
}

enum DocumentSourceType {
  UPLOAD
  URL

  @@map("document_source_type")
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED

  @@map("document_status")
}

enum ResourceType {
  FOLDER
  DOCUMENT

  @@map("resource_type")
}

enum PrincipalType {
  USER
  ORGANIZATION
  ORG_ROLE

  @@map("principal_type")
}

enum ResourceAccess {
  VIEW
  EDIT
  MANAGE

  @@map("resource_access")
}

enum IngestionStage {
  PARSE
  CHUNK
  EMBED
  INDEX

  @@map("ingestion_stage")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("job_status")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

enum CitationSourceKind {
  CHUNK
  WEB

  @@map("citation_source_kind")
}

model User {
  id                 String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email              String       @unique @db.Citext
  emailVerifiedAt    DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  passwordHash       String?      @map("password_hash")
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  name               String
  avatarUrl          String?      @map("avatar_url")
  locale             Locale       @default(vi)
  platformRole       PlatformRole @default(USER) @map("platform_role")
  status             UserStatus   @default(PENDING)
  accountType        AccountType  @default(INDIVIDUAL) @map("account_type")
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdById        String?      @map("created_by") @db.Uuid
  deactivatedAt      DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  deactivatedById    String?      @map("deactivated_by") @db.Uuid
  deactivationReason String?      @map("deactivation_reason")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)

  createdUsers            User[]                   @relation("UserCreator")
  createdBy               User?                    @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deactivatedUsers        User[]                   @relation("UserDeactivator")
  deactivatedBy           User?                    @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  authTokens              AuthToken[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  memberships             OrganizationMember[]
  invitations             OrganizationInvitation[] @relation("InvitationSender")
  permissionOverrides     UserPermissionOverride[] @relation("OverrideTarget")
  grantedOverrides        UserPermissionOverride[] @relation("OverrideGrantor")
  auditLogs               AuditLog[]               @relation("AuditActor")
  interpreterSettings     InterpreterSettings?
  meetings                Meeting[]                @relation("MeetingOwner")
  glossaryTerms           GlossaryTerm[]           @relation("GlossaryOwner")
  rooms                   Room[]                   @relation("RoomOwner")
  usageEvents             UsageEvent[]
  memberQuotas            MemberQuota[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  ownedFolders            Folder[]                 @relation("FolderOwner")
  uploadedDocuments       Document[]               @relation("DocumentUploader")
  ownedDocuments          Document[]               @relation("DocumentOwner")
  createdVersions         DocumentVersion[]        @relation("VersionCreator")
  grantedAccess           AccessGrant[]            @relation("Grantor")
  conversations           Conversation[]

  @@index([platformRole, status])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Organization {
  id           String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name         String
  slug         String             @unique
  ownerUserId  String             @map("owner_user_id") @db.Uuid
  status       OrganizationStatus @default(ACTIVE)
  taxCode      String?            @map("tax_code")
  address      String?
  billingEmail String?            @map("billing_email") @db.Citext
  logoUrl      String?            @map("logo_url")
  settings     Json               @default("{}") @db.JsonB
  maxMembers   Int?               @map("max_members")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  owner         User                     @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  auditLogs     AuditLog[]
  meetings      Meeting[]
  glossaryTerms GlossaryTerm[]           @relation("GlossaryOrganization")
  rooms         Room[]
  usageEvents   UsageEvent[]
  memberQuotas  MemberQuota[]
  notifications Notification[]
  folders       Folder[]                 @relation("FolderOrganization")
  documents     Document[]               @relation("DocumentOrganization")
  conversations Conversation[]           @relation("ConversationOrganization")

  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  orgRole        OrganizationRole @map("org_role")
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?          @map("invited_by") @db.Uuid
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.Citext
  orgRole        OrganizationRole @map("org_role")
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model Permission {
  key         String                   @id
  description String
  scope       PermissionScope
  roleGrants  RolePermission[]
  overrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  role          String
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  permissionKey String           @map("permission_key")
  effect        PermissionEffect
  grantedById   String           @map("granted_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User             @relation("OverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission       @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  grantedBy     User             @relation("OverrideGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, permissionKey])
  @@index([grantedById])
  @@map("user_permission_overrides")
}

model AuditLog {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actorRole      String?       @map("actor_role")
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  ip             String?       @db.Inet
  userAgent      String?       @map("user_agent")
  metadata       Json          @default("{}") @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model InterpreterSettings {
  userId            String      @id @map("user_id") @db.Uuid
  personaName       String      @default("AI Interpreter") @map("persona_name")
  avatarUrl         String?     @map("avatar_url")
  voiceGender       VoiceGender @default(NEUTRAL) @map("voice_gender")
  voiceStyle        VoiceStyle  @default(PROFESSIONAL) @map("voice_style")
  speed             Decimal     @default(1.0) @db.Decimal(3, 2)
  volume            Decimal     @default(1.0) @db.Decimal(3, 2)
  duckOriginalPct   Int         @default(15) @map("duck_original_pct")
  triggerMode       TriggerMode @default(AUTO) @map("trigger_mode")
  endpointingMs     Int         @default(700) @map("endpointing_ms")
  defaultSourceLang String      @default("vi") @map("default_source_lang")
  defaultTargetLang String      @default("en") @map("default_target_lang")
  saveHistory       Boolean     @default(true) @map("save_history")
  storageMode       StorageMode @default(CLOUD) @map("storage_mode")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interpreter_settings")
}

model Meeting {
  id             String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerId        String               @map("owner_id") @db.Uuid
  organizationId String?              @map("organization_id") @db.Uuid
  type           MeetingType
  title          String?
  platform       MeetingPlatform
  meetingUrl     String?              @map("meeting_url")
  sourceLang     String               @map("source_lang")
  targetLang     String               @map("target_lang")
  status         MeetingStatus        @default(CREATED)
  startedAt      DateTime?            @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?            @map("ended_at") @db.Timestamptz(6)
  durationSec    Int?                 @map("duration_sec")
  customerTag    String?              @map("customer_tag")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)
  owner          User                 @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  participants   MeetingParticipant[]
  turns          Turn[]
  summary        MeetingSummary?
  bot            Bot?
  usageEvents    UsageEvent[]

  @@index([ownerId, startedAt(sort: Desc)])
  @@index([organizationId, startedAt(sort: Desc)])
  @@index([status])
  @@map("meetings")
}

model MeetingParticipant {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  meetingId   String    @map("meeting_id") @db.Uuid
  displayName String    @map("display_name")
  externalId  String?   @map("external_id")
  lang        String?
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  turns       Turn[]

  @@index([meetingId, joinedAt])
  @@map("meeting_participants")
}

model Turn {
  id                String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  meetingId         String              @map("meeting_id") @db.Uuid
  participantId     String?             @map("participant_id") @db.Uuid
  speakerLabel      String?             @map("speaker_label")
  lang              String
  originalTextEnc   String              @map("original_text_enc")
  translatedTextEnc String              @map("translated_text_enc")
  emotion           String?
  startedMs         Int                 @map("started_ms")
  endedMs           Int                 @map("ended_ms")
  sttConfidence     Float?              @map("stt_confidence")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  meeting           Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant       MeetingParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([meetingId, startedMs])
  @@map("turns")
}

model MeetingSummary {
  meetingId    String   @id @map("meeting_id") @db.Uuid
  summaryMdEnc String   @map("summary_md_enc")
  actionItems  Json     @default("[]") @map("action_items") @db.JsonB
  decisions    Json     @default("[]") @db.JsonB
  generatedAt  DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_summaries")
}

model GlossaryTerm {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerUserId    String?       @map("owner_user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  sourceLang     String        @map("source_lang")
  targetLang     String        @map("target_lang")
  sourceTerm     String        @map("source_term")
  targetTerm     String        @map("target_term")
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner          User?         @relation("GlossaryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization   Organization? @relation("GlossaryOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, sourceLang, targetLang])
  @@index([organizationId, sourceLang, targetLang])
  @@map("glossary_terms")
}

model Bot {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  meetingId   String   @unique @map("meeting_id") @db.Uuid
  vendor      String
  vendorBotId String?  @map("vendor_bot_id")
  status      String
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([vendor, vendorBotId])
  @@map("bots")
}

model Room {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  livekitRoom    String        @unique @map("livekit_room")
  inviteCode     String        @unique @map("invite_code")
  status         String
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  owner          User          @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([organizationId, createdAt])
  @@map("rooms")
}

model BillingAccount {
  id                     String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerType              BillingOwnerType @map("owner_type")
  ownerId                String           @map("owner_id") @db.Uuid
  providerCustomerId     String?          @map("provider_customer_id")
  currency               String           @default("USD") @db.Char(3)
  billingEmail           String?          @map("billing_email") @db.Citext
  taxCode                String?          @map("tax_code")
  defaultPaymentMethodId String?          @map("default_payment_method_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  usageEvents          UsageEvent[]
  quotaCounters        QuotaCounter[]
  paymentMethods       PaymentMethod[]     @relation("BillingPaymentMethods")
  defaultPaymentMethod PaymentMethod?      @relation("BillingDefaultPaymentMethod", fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)

  @@unique([ownerType, ownerId])
  @@index([ownerId])
  @@map("billing_accounts")
}

model Plan {
  id                       String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code                     String          @unique
  name                     String
  description              String?
  priceMinor               BigInt          @default(0) @map("price_minor")
  currency                 String          @default("USD") @db.Char(3)
  interval                 BillingInterval
  intervalCount            Int             @default(1) @map("interval_count")
  allowedIntervals         BillingCycle[]  @default([MONTH]) @map("allowed_intervals")
  includedInterpretMinutes Int             @default(0) @map("included_interpret_minutes")
  includedAiTokens         BigInt          @default(0) @map("included_ai_tokens")
  storageQuotaBytes        BigInt          @default(0) @map("storage_quota_bytes")
  maxDocuments             Int             @default(0) @map("max_documents")
