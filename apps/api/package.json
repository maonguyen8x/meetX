{
  "name": "@meetx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "worker": "tsx src/worker.ts",
    "lint": "eslint src prisma scripts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env.example -- vitest run --exclude **/*.integration.test.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- prisma db seed --schema prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "db:set-embedding-dim": "tsx scripts/set-embedding-dim.ts && pnpm db:generate",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "9",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/websocket": "^11.0.2",
    "@meetx/shared": "workspace:*",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.9",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.2",
    "prisma": "^6.4.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
